# Copy to .env (create-env.bat does it for you). NEVER send .env to GitHub.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=foldifyer
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
# Google Gemini key (https://aistudio.google.com/apikey). Picture models need billing switched on.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# For tests: everyone can make figures without paying
DEV_ALL_PRO=true
# RevenueCat secret key (only when purchases are set up)
REVENUECAT_SECRET_KEY=
PUBLIC_URL=

# --- Optional: Cloudflare R2 for figure pictures (instead of MongoDB) ---
# Fill all five and restart: new pictures go to R2. Old pictures stay in MongoDB and keep working.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket, e.g. https://pub-xxxx.r2.dev (no slash at the end)
R2_PUBLIC_URL=
