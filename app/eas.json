{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "demo": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_DEMO": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://foldifyer-production.up.railway.app",
        "EXPO_PUBLIC_RC_ANDROID_KEY": "goog_PASTE_PUBLIC_ANDROID_KEY",
        "EXPO_PUBLIC_RC_IOS_KEY": "appl_DGwSKsUUKtqDQNneFOxqHQqEcVj"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://foldifyer-production.up.railway.app",
        "EXPO_PUBLIC_RC_ANDROID_KEY": "goog_PASTE_PUBLIC_ANDROID_KEY",
        "EXPO_PUBLIC_RC_IOS_KEY": "appl_DGwSKsUUKtqDQNneFOxqHQqEcVj"
      }
    }
  },
  "submit": {
    "production": {}
  }
}