{
  "expo": {
    "name": "Foldifyer",
    "slug": "foldifyer",
    "scheme": "foldifyer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.foldifyer.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Foldifyer uses the camera to photograph your pet or a person for a paper figure, and your finished toy.",
        "NSPhotoLibraryUsageDescription": "Foldifyer lets you pick a photo of your pet or a person to make a paper figure.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.foldifyer.app",
      "adaptiveIcon": {
        "backgroundColor": "#F3E3CC",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8EE",
          "dark": {
            "backgroundColor": "#1B1611"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Foldifyer uses the camera to photograph your pet or a person for a paper figure, and your finished toy.",
          "photosPermission": "Foldifyer lets you pick a photo of your pet or a person to make a paper figure.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
